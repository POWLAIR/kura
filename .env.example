# Copier en .env (jamais commité). Valeurs locales : `pnpm db:start` les affiche.
# Base déployée : copier en .env.production, puis KURA_ENV_FILE=.env.production pnpm <script>
# (voir docs/deploiement.md).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Serveur uniquement — ne jamais exposer côté app. Clé secrète (sb_secret_…) ou service_role.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
NOTION_TOKEN=
