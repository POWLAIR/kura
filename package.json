{
  "name": "kura",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --if-present typecheck && pnpm functions:check",
    "test": "pnpm -r --if-present test && pnpm functions:test",
    "functions:check": "for f in supabase/functions/*/deno.json; do deno check --config \"$f\" \"$(dirname \"$f\")\" || exit 1; done",
    "functions:test": "for f in supabase/functions/*/deno.json; do deno test --config \"$f\" --allow-env --allow-net \"$(dirname \"$f\")\" || exit 1; done",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new",
    "db:types": "supabase gen types typescript --local > packages/core/src/database.types.ts",
    "import:ciqual": "pnpm --filter @kura/scripts import:ciqual",
    "import:notion": "pnpm --filter @kura/scripts import:notion",
    "mcp:key": "pnpm --filter @kura/scripts mcp:key"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "supabase": "^2.120.0",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "runtime": {
      "name": "deno",
      "version": "2.9.6",
      "onFail": "download"
    }
  }
}
