    "aes-js": "3.1.2",
    "expo": "~58.0.23",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.8",
    "expo-file-system": "~58.0.13",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
